# Machine-readable project configuration (project-owned, never synced).
# Plain KEY=VALUE lines, no shell expansion. Read by scripts/env.sh, the Makefile,
# tools/check.sh and tools/new_package.py. The prose version lives in PROJECT.md.

PROJECT_NAME=ros2_project
ROS_DISTRO=jazzy

# Middleware. RMW_CONFIG_FILE is relative to the workspace root (empty = RMW defaults).
# Cyclone: e.g. config/cyclonedds.xml -> CYCLONEDDS_URI; Fast DDS: -> FASTRTPS_DEFAULT_PROFILES_FILE.
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
RMW_CONFIG_FILE=
ROS_DOMAIN_ID=0

# Development environment: native | docker | isaac_ros   (docs/agent/devenv.md)
DEVENV=native
CONTAINER_NAME=ros2_project_dev
CONTAINER_WS=/workspaces/ros2_ws
# docker backend only: base image and whether to pass GPUs (auto | on | off)
DOCKER_BASE_IMAGE=ros:jazzy-ros-base
CONTAINER_GPU=auto
# isaac_ros backend only: image key -> Dockerfile.<key> at the workspace root
ISAAC_ROS_IMAGE_KEY=ws

# Scaffolding defaults (tools/new_package.py)
ROS_MAINTAINER_NAME=
ROS_MAINTAINER_EMAIL=
ROS_COPYRIGHT_HOLDER=

# Build and verification
BUILD_JOBS=
COVERAGE_MIN_LINES=80
